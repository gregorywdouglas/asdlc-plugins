{
  "description": "asdlc intent gate: blocks writing a spec.md until its paired intent passes the accept rule",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_gate.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
